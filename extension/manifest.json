{
	"manifest_version": 3,
	"name": "Japanese UI & Glossary for GitHub",
	"short_name": "GitHub-ja",
	"description": "GitHub の画面を自然な日本語に。Pull request や Fork などの用語はカーソルを乗せると意味がわかる。通信なし。Japanese UI and Git glossary for GitHub (unofficial).",
	"version": "0.2.0",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"permissions": [
		"storage"
	],
	"content_scripts": [
		{
			"matches": [
				"https://github.com/*",
				"https://gist.github.com/*"
			],
			"js": [
				"src/terms.js",
				"src/dict-ja.js",
				"src/content.js"
			],
			"css": [
				"src/content.css"
			],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_popup": "popup/popup.html",
		"default_title": "GitHub-ja",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png"
		}
	}
}
